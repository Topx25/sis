    {
      "name": "🔒 Admin APIs (Manage Content)",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sis.com\",\n  \"password\": \"password\"\n}"
            },
            "url": { "raw": "{{base_url}}/admin/login", "host": ["{{base_url}}"], "path": ["admin", "login"] }
          }
        },
        {
          "name": "Get Solution Page (e.g. digital)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": { "raw": "{{base_url}}/admin/solution-pages/digital", "host": ["{{base_url}}"], "path": ["admin", "solution-pages", "digital"] }
          }
        },
        {
          "name": "Update Solution Page",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": {\n    \"en\": \"Digital Solutions\",\n    \"ar\": \"الحلول الرقمية المتقدمة\"\n  }\n}"
            },
            "url": { "raw": "{{base_url}}/admin/solution-pages/digital", "host": ["{{base_url}}"], "path": ["admin", "solution-pages", "digital"] }
          }
        },
        {
          "name": "Get Use Cases Page Settings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": { "raw": "{{base_url}}/admin/use-cases-page", "host": ["{{base_url}}"], "path": ["admin", "use-cases-page"] }
          }
        },
        {

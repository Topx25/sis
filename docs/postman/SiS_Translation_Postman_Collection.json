{
  "info": {
    "name": "SiS API — Complete Multi-Language & Pages Collection",
    "_postman_id": "sis-complete-collection",
    "description": "Complete Postman collection for all SiS API endpoints.\nIncludes all 8 screenshot-backed pages, Public Endpoints, and Admin CRUD with Accept-Language support (ar / en).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/sis-api/public/api/v1",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [

          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": { "raw": "{{base_url}}/admin/trusted-partners-page", "host": ["{{base_url}}"], "path": ["admin", "trusted-partners-page"] }
          }
